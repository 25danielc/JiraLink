# Copy to `.env` for local runs (never commit `.env`). In CI these are GitHub
# Actions secrets, not a file.

# Your Jira Cloud base URL, no trailing slash.
JIRA_BASE=https://yourco.atlassian.net

# The Atlassian account email that owns the API token below.
JIRA_EMAIL=you@yourco.com

# Atlassian API token: https://id.atlassian.com/manage-profile/security/api-tokens
# Read-only is enough. If the token offers scopes, `read:jira-work` covers it —
# the pipeline only runs a JQL search and reads fields; it never writes to Jira.
JIRA_TOKEN=your_api_token_here

# Your Jira project key (the prefix on issue keys, e.g. ENG in ENG-123).
JIRA_PROJECT_KEY=PROJ

# The "Changelog Entry" custom field id (Jira: Settings -> Issues -> Custom fields).
CHANGELOG_FIELD_ID=customfield_XXXXX

# The exact name of your terminal "shipped" status (you call it Completed).
COMPLETED_STATUS=Done

# Safety-net reconcile window in days (optional; defaults to 90).
LOOKBACK_DAYS=90
